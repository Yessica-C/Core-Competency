[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_3h01y"]
output_port_for_preview = 0
size = Vector2(600, 460)
expression = "	vec3 lum_magic = vec3(color.rgb) * vec3(0.29900, 0.58700, 0.11400);
	float pixel_lum = lum_magic.r + lum_magic.g + lum_magic.b;
	
    vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
	float n = fract(magic.z * fract(dot(FRAGCOORD.xy, magic.xy)));
	
	//float n = gradient_noise(FRAGCOORD.xy);
	color.r = floor(color.r * 1.0 + n) / 2.0;
	color.g = floor(color.g * 1.0 + n) / 2.0;
	color.b = floor(color.b * 1.0 + n) / 2.0;
	
	cout = color.rgb;"

